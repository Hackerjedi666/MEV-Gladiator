# Coordinator inherits env from the repo root .env via dotenv walking up.
# See ../.env.example for the canonical key list.
#
# Required (live mode only):
#   MONAD_RPC_URL
#   COORDINATOR_PRIVATE_KEY    # signs Coliseum.startRound / endRound / recordExtraction
#   VICTIM_PRIVATE_KEY         # signs synthetic victim DEX swaps
#
# Optional:
#   COORDINATOR_MODE=live              # live | mock
#   COORDINATOR_HTTP_PORT=3001
#   COORDINATOR_DEPLOYMENT_PATH=../contracts/deployments/monad-testnet.json
#   LOG_LEVEL=info
#   LOG_PRETTY=true
